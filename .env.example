# Optional. If set, get_hint calls the Gemini API for a real AI-generated
# Socratic hint. If unset, get_hint falls back to the static hints defined in
# each mission (still works fine, just less adaptive).
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. Check ai.google.dev for the current
# recommended model name - this field moves fast.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Port the HTTP server listens on. Defaults to 3000.
PORT=3000

# Optional. Where progress.json is written. Defaults to ./.data
TUTOR_DATA_DIR=
